<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (success && success.length) { %>
        <div class="alert alert-success">
          <% success.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="quick-actions">
        <a href="/devices/create" class="quick-action-card">
          <strong>Nova Entrada</strong>
          <span>Registrar dispositivo</span>
        </a>

        <a href="/repairs/create" class="quick-action-card">
          <strong>Novo Reparo</strong>
          <span>Abrir diagnóstico</span>
        </a>

        <a href="/sales/create" class="quick-action-card">
          <strong>Nova Venda</strong>
          <span>Cobrar cliente</span>
        </a>

        <a href="/finance/create" class="quick-action-card">
          <strong>Nova Transação</strong>
          <span>Entrada ou saída</span>
        </a>

        <a href="/reports" class="quick-action-card">
          <strong>Relatórios</strong>
          <span>Dados completos</span>
        </a>

        <a href="/admin/backups" class="quick-action-card">
          <strong>Backup</strong>
          <span>Cópia do banco</span>
        </a>
      </section>

      <section class="cards dashboard-cards">
        <div class="card">
          <span class="card-label">Clientes</span>
          <h2><%= stats.clients %></h2>
          <p>Total de clientes cadastrados.</p>
        </div>

        <div class="card">
          <span class="card-label">Dispositivos</span>
          <h2><%= stats.devices %></h2>
          <p>Aparelhos recebidos no sistema.</p>
        </div>

        <div class="card">
          <span class="card-label">Reparos em aberto</span>
          <h2><%= stats.repairsOpen %></h2>
          <p>Serviços em andamento.</p>
        </div>

        <div class="card">
          <span class="card-label">Reparos finalizados</span>
          <h2><%= stats.repairsFinished %></h2>
          <p>Serviços concluídos.</p>
        </div>

        <div class="card">
          <span class="card-label">Unidades em estoque</span>
          <h2><%= stats.stockUnits %></h2>
          <p>Peças disponíveis.</p>
        </div>

        <div class="card">
          <span class="card-label">Estoque baixo</span>
          <h2><%= stats.lowStock %></h2>
          <p>Peças abaixo ou no mínimo.</p>
        </div>

        <div class="card">
          <span class="card-label">Vendas pagas</span>
          <h2><%= stats.salesPaid %></h2>
          <p>Vendas recebidas.</p>
        </div>

        <div class="card">
          <span class="card-label">Entregas</span>
          <h2><%= stats.deliveries %></h2>
          <p>Dispositivos entregues.</p>
        </div>
      </section>

      <section class="cards finance-dashboard-cards">
        <div class="card finance-card">
          <span class="card-label">Receita do mês</span>
          <h2>R$ <%= Number(stats.incomeMonth || 0).toFixed(2) %></h2>
          <p>Entradas pagas neste mês.</p>
        </div>

        <div class="card finance-card">
          <span class="card-label">Despesas do mês</span>
          <h2>R$ <%= Number(stats.expenseMonth || 0).toFixed(2) %></h2>
          <p>Saídas pagas neste mês.</p>
        </div>

        <div class="card finance-card">
          <span class="card-label">Resultado do mês</span>
          <h2>R$ <%= Number(stats.monthBalance || 0).toFixed(2) %></h2>
          <p>Receita menos despesas.</p>
        </div>

        <div class="card finance-card">
          <span class="card-label">Saldo geral</span>
          <h2>R$ <%= Number(stats.totalBalance || 0).toFixed(2) %></h2>
          <p>Saldo financeiro acumulado.</p>
        </div>
      </section>

      <section class="dashboard-chart-grid">
        <div class="panel chart-panel">
          <div class="panel-header">
            <div>
              <h2>Evolução Financeira</h2>
              <p>Receitas e despesas pagas nos últimos 6 meses.</p>
            </div>
          </div>

          <div class="chart-box">
            <canvas id="financeEvolutionChart"></canvas>
          </div>
        </div>

        <div class="panel chart-panel">
          <div class="panel-header">
            <div>
              <h2>Vendas por Mês</h2>
              <p>Quantidade e valor vendido.</p>
            </div>
          </div>

          <div class="chart-box">
            <canvas id="salesEvolutionChart"></canvas>
          </div>
        </div>
      </section>

      <section class="dashboard-chart-grid">
        <div class="panel chart-panel">
          <div class="panel-header">
            <div>
              <h2>Dispositivos Recebidos</h2>
              <p>Evolução de entradas de dispositivos.</p>
            </div>
          </div>

          <div class="chart-box">
            <canvas id="devicesEvolutionChart"></canvas>
          </div>
        </div>

        <div class="panel chart-panel">
          <div class="panel-header">
            <div>
              <h2>Reparos</h2>
              <p>Reparos abertos versus finalizados.</p>
            </div>
          </div>

          <div class="chart-box">
            <canvas id="repairsEvolutionChart"></canvas>
          </div>
        </div>
      </section>

      <section class="dashboard-chart-grid dashboard-chart-grid-small">
        <div class="panel chart-panel">
          <div class="panel-header">
            <div>
              <h2>Status dos Dispositivos</h2>
              <p>Distribuição atual.</p>
            </div>
          </div>

          <div class="chart-box chart-box-small">
            <canvas id="deviceStatusChart"></canvas>
          </div>
        </div>

        <div class="panel chart-panel">
          <div class="panel-header">
            <div>
              <h2>Status dos Reparos</h2>
              <p>Distribuição dos serviços.</p>
            </div>
          </div>

          <div class="chart-box chart-box-small">
            <canvas id="repairStatusChart"></canvas>
          </div>
        </div>

        <div class="panel chart-panel">
          <div class="panel-header">
            <div>
              <h2>Status das Vendas</h2>
              <p>Distribuição das vendas.</p>
            </div>
          </div>

          <div class="chart-box chart-box-small">
            <canvas id="saleStatusChart"></canvas>
          </div>
        </div>
      </section>

      <section class="dashboard-grid">
        <div class="panel dashboard-panel">
          <div class="panel-header">
            <div>
              <h2>Últimos Dispositivos</h2>
              <p>Entradas recentes.</p>
            </div>

            <a href="/devices" class="btn btn-small">Ver todos</a>
          </div>

          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Dispositivo</th>
                  <th>Cliente</th>
                  <th>Status</th>
                </tr>
              </thead>

              <tbody>
                <% if (latestDevices.length === 0) { %>
                  <tr>
                    <td colspan="3" class="empty-table">Nenhum dispositivo cadastrado.</td>
                  </tr>
                <% } %>

                <% latestDevices.forEach(function(device) { %>
                  <tr>
                    <td>
                      <strong><%= device.device_type %></strong><br>
                      <span class="text-muted"><%= device.brand || '-' %> <%= device.model || '' %></span>
                    </td>

                    <td>
                      <%= device.client_name %><br>
                      <span class="text-muted"><%= device.client_phone || '-' %></span>
                    </td>

                    <td>
                      <span class="badge <%= statusClasses[device.status] || 'badge-role' %>">
                        <%= deviceStatusLabels[device.status] || device.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="panel dashboard-panel">
          <div class="panel-header">
            <div>
              <h2>Últimos Reparos</h2>
              <p>Serviços técnicos recentes.</p>
            </div>

            <a href="/repairs" class="btn btn-small">Ver todos</a>
          </div>

          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Reparo</th>
                  <th>Técnico</th>
                  <th>Status</th>
                </tr>
              </thead>

              <tbody>
                <% if (latestRepairs.length === 0) { %>
                  <tr>
                    <td colspan="3" class="empty-table">Nenhum reparo cadastrado.</td>
                  </tr>
                <% } %>

                <% latestRepairs.forEach(function(repair) { %>
                  <tr>
                    <td>
                      <strong>#<%= repair.id %> - <%= repair.client_name %></strong><br>
                      <span class="text-muted"><%= repair.device_type %> <%= repair.brand || '' %> <%= repair.model || '' %></span>
                    </td>

                    <td><%= repair.technician_name || '-' %></td>

                    <td>
                      <span class="badge <%= statusClasses[repair.status] || 'badge-role' %>">
                        <%= repairStatusLabels[repair.status] || repair.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="dashboard-grid">
        <div class="panel dashboard-panel">
          <div class="panel-header">
            <div>
              <h2>Últimas Vendas</h2>
              <p>Vendas e cobranças recentes.</p>
            </div>

            <a href="/sales" class="btn btn-small">Ver todas</a>
          </div>

          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Venda</th>
                  <th>Cliente</th>
                  <th>Total</th>
                  <th>Status</th>
                </tr>
              </thead>

              <tbody>
                <% if (latestSales.length === 0) { %>
                  <tr>
                    <td colspan="4" class="empty-table">Nenhuma venda cadastrada.</td>
                  </tr>
                <% } %>

                <% latestSales.forEach(function(sale) { %>
                  <tr>
                    <td><strong>#<%= sale.id %></strong></td>
                    <td><%= sale.client_name || '-' %></td>
                    <td><strong>R$ <%= Number(sale.total_amount || 0).toFixed(2) %></strong></td>
                    <td>
                      <span class="badge <%= statusClasses[sale.status] || 'badge-role' %>">
                        <%= saleStatusLabels[sale.status] || sale.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="panel dashboard-panel">
          <div class="panel-header">
            <div>
              <h2>Movimentações Financeiras</h2>
              <p>Últimas entradas e saídas.</p>
            </div>

            <a href="/finance/transactions" class="btn btn-small">Ver financeiro</a>
          </div>

          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Tipo</th>
                  <th>Categoria</th>
                  <th>Valor</th>
                </tr>
              </thead>

              <tbody>
                <% if (latestTransactions.length === 0) { %>
                  <tr>
                    <td colspan="4" class="empty-table">Nenhuma movimentação financeira.</td>
                  </tr>
                <% } %>

                <% latestTransactions.forEach(function(item) { %>
                  <tr>
                    <td><%= item.created_at %></td>
                    <td>
                      <span class="badge <%= statusClasses[item.type] || 'badge-role' %>">
                        <%= item.type === 'income' ? 'Receita' : 'Despesa' %>
                      </span>
                    </td>
                    <td><%= item.category %></td>
                    <td><strong>R$ <%= Number(item.amount || 0).toFixed(2) %></strong></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script src="/vendor/chartjs/chart.umd.js"></script>
  <script>
    window.dashboardCharts = <%- JSON.stringify(dashboardCharts || {}) %>;
  </script>
  <script src="/js/dashboard-charts.js"></script>
  <%- include('../../partials/scripts') %>
</body>
</html>
