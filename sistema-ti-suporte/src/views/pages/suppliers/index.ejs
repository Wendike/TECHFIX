<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (success && success.length) { %>
        <div class="alert alert-success">
          <% success.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Cadastro de Fornecedores</h2>
            <p>Gerencie fornecedores de peças, contatos comerciais e vínculo com usuários do sistema.</p>
          </div>

          <a href="/suppliers/create" class="btn btn-primary">Novo Fornecedor</a>
        </div>

        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Fornecedor</th>
                <th>Contato</th>
                <th>Documento</th>
                <th>Usuário vinculado</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>

            <tbody>
              <% if (suppliers.length === 0) { %>
                <tr>
                  <td colspan="6" class="empty-table">Nenhum fornecedor cadastrado.</td>
                </tr>
              <% } %>

              <% suppliers.forEach(function(supplier) { %>
                <tr>
                  <td>
                    <strong><%= supplier.company_name %></strong><br>
                    <span class="text-muted"><%= supplier.city || '' %><%= supplier.state ? ' - ' + supplier.state : '' %></span>
                  </td>

                  <td>
                    <strong><%= supplier.contact_name || '-' %></strong><br>
                    <span class="text-muted"><%= supplier.email || '-' %></span><br>
                    <span class="text-muted"><%= supplier.phone || '-' %></span>
                  </td>

                  <td><%= supplier.document || '-' %></td>

                  <td>
                    <% if (supplier.user_name) { %>
                      <strong><%= supplier.user_name %></strong><br>
                      <span class="text-muted"><%= supplier.user_email %></span>
                    <% } else { %>
                      <span class="text-muted">Sem vínculo</span>
                    <% } %>
                  </td>

                  <td>
                    <span class="badge <%= supplier.status === 'active' ? 'badge-success' : 'badge-danger' %>">
                      <%= supplier.status === 'active' ? 'Ativo' : 'Inativo' %>
                    </span>
                  </td>

                  <td>
                    <div class="actions">
                      <a href="/suppliers/<%= supplier.id %>" class="btn btn-small">Ver</a>
                      <a href="/suppliers/<%= supplier.id %>/edit" class="btn btn-small btn-warning">Editar</a>

                      <form method="POST" action="/suppliers/<%= supplier.id %>/status">
                        <button type="submit" class="btn btn-small <%= supplier.status === 'active' ? 'btn-danger' : 'btn-success' %>">
                          <%= supplier.status === 'active' ? 'Inativar' : 'Ativar' %>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
