<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Editar Fornecedor</h2>
            <p>Atualize dados comerciais, contato, endereço e vínculo de acesso.</p>
          </div>

          <a href="/suppliers" class="btn">Voltar</a>
        </div>

        <form method="POST" action="/suppliers/<%= supplier.id %>/update" class="form-grid">
          <div class="form-group">
            <label>Usuário vinculado</label>
            <select name="user_id">
              <option value="">Nenhum usuário vinculado</option>
              <% supplierUsers.forEach(function(userOption) { %>
                <option value="<%= userOption.id %>" <%= Number(supplier.user_id) === Number(userOption.id) ? 'selected' : '' %>>
                  <%= userOption.name %> - <%= userOption.email %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Status</label>
            <select name="status">
              <% statuses.forEach(function(status) { %>
                <option value="<%= status.value %>" <%= supplier.status === status.value ? 'selected' : '' %>>
                  <%= status.label %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Empresa / Fornecedor *</label>
            <input type="text" name="company_name" value="<%= supplier.company_name %>" required>
          </div>

          <div class="form-group">
            <label>Nome do contato</label>
            <input type="text" name="contact_name" value="<%= supplier.contact_name || '' %>">
          </div>

          <div class="form-group">
            <label>E-mail</label>
            <input type="email" name="email" value="<%= supplier.email || '' %>">
          </div>

          <div class="form-group">
            <label>Telefone</label>
            <input type="text" name="phone" value="<%= supplier.phone || '' %>">
          </div>

          <div class="form-group">
            <label>CNPJ / CPF</label>
            <input type="text" name="document" value="<%= supplier.document || '' %>">
          </div>

          <div class="form-group">
            <label>Endereço</label>
            <input type="text" name="address" value="<%= supplier.address || '' %>">
          </div>

          <div class="form-group">
            <label>Cidade</label>
            <input type="text" name="city" value="<%= supplier.city || '' %>">
          </div>

          <div class="form-group">
            <label>Estado</label>
            <input type="text" name="state" maxlength="2" value="<%= supplier.state || '' %>">
          </div>

          <div class="form-group">
            <label>CEP</label>
            <input type="text" name="zip_code" value="<%= supplier.zip_code || '' %>">
          </div>

          <div class="form-group form-full">
            <label>Observações</label>
            <textarea name="notes" rows="4"><%= supplier.notes || '' %></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Atualizar Fornecedor</button>
            <a href="/suppliers" class="btn">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
