<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body class="auth-page">
  <main class="auth-container">
    <section class="auth-card">
      <div class="auth-brand">
        <h1>TECHFIX</h1>
        <p>Recuperação de senha</p>
      </div>

      <% if (success && success.length) { %>
        <div class="alert alert-success">
          <% success.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (resetLink) { %>
        <div class="login-help">
          <strong>Link de recuperação gerado</strong>
          <p>
            Como ainda não configuramos envio de e-mail, use o botão abaixo para redefinir a senha.
          </p>
          <a href="<%= resetLink %>" class="btn btn-primary btn-full">Redefinir senha agora</a>
        </div>
      <% } %>

      <form method="POST" action="/forgot-password">
        <div class="form-group">
          <label>E-mail cadastrado</label>
          <input type="email" name="email" required placeholder="Digite seu e-mail">
        </div>

        <button type="submit" class="btn btn-primary btn-full">Gerar recuperação</button>
      </form>

      <div class="login-actions">
        <a href="/login">Voltar ao login</a>
        <a href="/first-access">Primeiro acesso de Cliente</a>
      </div>
    </section>
  </main>

  <%- include('../../partials/scripts') %>
</body>
</html>
