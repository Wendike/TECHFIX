<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Editar Entrega</h2>
            <p>Atualize dados da retirada, observações e status da entrega.</p>
          </div>

          <a href="/deliveries" class="btn">Voltar</a>
        </div>

        <form method="POST" action="/deliveries/<%= delivery.id %>/update" class="form-grid">
          <div class="form-group form-full">
            <label>Dispositivo</label>
            <input type="text" value="#<%= delivery.device_id %> - <%= delivery.device_type %> <%= delivery.brand || '' %> <%= delivery.model || '' %> - <%= delivery.client_name %>" disabled>
          </div>

          <div class="form-group">
            <label>Nome de quem retirou *</label>
            <input type="text" name="received_by_name" value="<%= delivery.received_by_name || '' %>" required>
          </div>

          <div class="form-group">
            <label>Status</label>
            <select name="status">
              <% statusOptions.forEach(function(option) { %>
                <option value="<%= option.value %>" <%= delivery.status === option.value ? 'selected' : '' %>>
                  <%= option.label %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Data da entrega</label>
            <input type="datetime-local" name="delivery_date" value="<%= delivery.delivery_date ? String(delivery.delivery_date).replace(' ', 'T').substring(0, 16) : '' %>">
          </div>

          <div class="form-group form-full">
            <label>Observações</label>
            <textarea name="notes" rows="4"><%= delivery.notes || '' %></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Atualizar Entrega</button>
            <a href="/deliveries" class="btn">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
