<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (success && success.length) { %>
        <div class="alert alert-success">
          <% success.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="admin-grid">
        <a href="/users" class="admin-card">
          <span>01</span>
          <strong>Usuários</strong>
          <p>Cadastrar, editar e controlar acesso dos usuários.</p>
        </a>

        <a href="/admin/permissions" class="admin-card">
          <span>02</span>
          <strong>Permissões</strong>
          <p>Visualizar regras de acesso por perfil.</p>
        </a>

        <a href="/admin/backups" class="admin-card">
          <span>03</span>
          <strong>Backups</strong>
          <p>Criar, baixar e excluir cópias do banco SQLite.</p>
        </a>

        <a href="/admin/logs" class="admin-card">
          <span>04</span>
          <strong>Logs</strong>
          <p>Auditoria de acessos e ações realizadas no sistema.</p>
        </a>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
