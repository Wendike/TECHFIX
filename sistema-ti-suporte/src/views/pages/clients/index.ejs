<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (success && success.length) { %>
        <div class="alert alert-success">
          <% success.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Cadastro de Clientes</h2>
            <p>Gerencie clientes atendidos, contatos, endereço e vínculo com usuário do sistema.</p>
          </div>

          <a href="/clients/create" class="btn btn-primary">Novo Cliente</a>
        </div>

        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Nome</th>
                <th>Contato</th>
                <th>Documento</th>
                <th>Usuário vinculado</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>

            <tbody>
              <% if (clients.length === 0) { %>
                <tr>
                  <td colspan="6" class="empty-table">Nenhum cliente cadastrado.</td>
                </tr>
              <% } %>

              <% clients.forEach(function(client) { %>
                <tr>
                  <td>
                    <strong><%= client.name %></strong><br>
                    <span class="text-muted"><%= client.city || '' %><%= client.state ? ' - ' + client.state : '' %></span>
                  </td>

                  <td>
                    <%= client.email || '-' %><br>
                    <span class="text-muted"><%= client.phone || '-' %></span>
                  </td>

                  <td><%= client.document || '-' %></td>

                  <td>
                    <% if (client.user_name) { %>
                      <strong><%= client.user_name %></strong><br>
                      <span class="text-muted"><%= client.user_email %></span>
                    <% } else { %>
                      <span class="text-muted">Sem vínculo</span>
                    <% } %>
                  </td>

                  <td>
                    <span class="badge <%= client.status === 'active' ? 'badge-success' : 'badge-danger' %>">
                      <%= client.status === 'active' ? 'Ativo' : 'Inativo' %>
                    </span>
                  </td>

                  <td>
                    <div class="actions">
                      <a href="/clients/<%= client.id %>" class="btn btn-small">Ver</a>
                      <a href="/clients/<%= client.id %>/edit" class="btn btn-small btn-warning">Editar</a>

                      <form method="POST" action="/clients/<%= client.id %>/status">
                        <button type="submit" class="btn btn-small <%= client.status === 'active' ? 'btn-danger' : 'btn-success' %>">
                          <%= client.status === 'active' ? 'Inativar' : 'Ativar' %>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
