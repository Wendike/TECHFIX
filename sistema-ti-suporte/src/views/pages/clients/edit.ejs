<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Editar Cliente</h2>
            <p>Atualize dados cadastrais, contato, endereço e vínculo de acesso.</p>
          </div>

          <a href="/clients" class="btn">Voltar</a>
        </div>

        <form method="POST" action="/clients/<%= client.id %>/update" class="form-grid">
          <div class="form-group">
            <label>Usuário vinculado</label>
            <select name="user_id">
              <option value="">Nenhum usuário vinculado</option>
              <% clientUsers.forEach(function(userOption) { %>
                <option value="<%= userOption.id %>" <%= Number(client.user_id) === Number(userOption.id) ? 'selected' : '' %>>
                  <%= userOption.name %> - <%= userOption.email %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Status</label>
            <select name="status">
              <% statuses.forEach(function(status) { %>
                <option value="<%= status.value %>" <%= client.status === status.value ? 'selected' : '' %>>
                  <%= status.label %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Nome do cliente *</label>
            <input type="text" name="name" value="<%= client.name %>" required>
          </div>

          <div class="form-group">
            <label>E-mail</label>
            <input type="email" name="email" value="<%= client.email || '' %>">
          </div>

          <div class="form-group">
            <label>Telefone</label>
            <input type="text" name="phone" value="<%= client.phone || '' %>">
          </div>

          <div class="form-group">
            <label>CPF/CNPJ</label>
            <input type="text" name="document" value="<%= client.document || '' %>">
          </div>

          <div class="form-group">
            <label>Endereço</label>
            <input type="text" name="address" value="<%= client.address || '' %>">
          </div>

          <div class="form-group">
            <label>Cidade</label>
            <input type="text" name="city" value="<%= client.city || '' %>">
          </div>

          <div class="form-group">
            <label>Estado</label>
            <input type="text" name="state" maxlength="2" value="<%= client.state || '' %>">
          </div>

          <div class="form-group">
            <label>CEP</label>
            <input type="text" name="zip_code" value="<%= client.zip_code || '' %>">
          </div>

          <div class="form-group form-full">
            <label>Observações</label>
            <textarea name="notes" rows="4"><%= client.notes || '' %></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Atualizar Cliente</button>
            <a href="/clients" class="btn">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
