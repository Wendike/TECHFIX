<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Nova Peça</h2>
            <p>Cadastre uma peça para controle de estoque, reposição, venda e uso em reparos.</p>
          </div>

          <a href="/parts" class="btn">Voltar</a>
        </div>

        <form method="POST" action="/parts" class="form-grid">
          <div class="form-group">
            <label>Nome da peça *</label>
            <input type="text" name="name" required placeholder="Ex: Tela iPhone 11">
          </div>

          <div class="form-group">
            <label>SKU / Código</label>
            <input type="text" name="sku" placeholder="Ex: TELA-IP11-PRETA">
          </div>

          <div class="form-group">
            <label>Fornecedor</label>
            <select name="supplier_id">
              <option value="">Nenhum fornecedor</option>
              <% suppliers.forEach(function(supplier) { %>
                <option value="<%= supplier.id %>">
                  <%= supplier.company_name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Categoria</label>
            <input type="text" name="category" placeholder="Ex: Tela, Bateria, Placa, Conector">
          </div>

          <div class="form-group">
            <label>Preço de custo</label>
            <input type="number" name="cost_price" step="0.01" min="0" value="0">
          </div>

          <div class="form-group">
            <label>Preço de venda</label>
            <input type="number" name="sale_price" step="0.01" min="0" value="0">
          </div>

          <div class="form-group">
            <label>Estoque atual</label>
            <input type="number" name="current_stock" min="0" value="0">
          </div>

          <div class="form-group">
            <label>Estoque mínimo</label>
            <input type="number" name="min_stock" min="0" value="0">
          </div>

          <div class="form-group">
            <label>Localização no estoque</label>
            <input type="text" name="location" placeholder="Ex: Gaveta A3, Prateleira 2">
          </div>

          <div class="form-group">
            <label>Status</label>
            <select name="status">
              <% statuses.forEach(function(status) { %>
                <option value="<%= status.value %>"><%= status.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group form-full">
            <label>Descrição</label>
            <textarea name="description" rows="4" placeholder="Detalhes técnicos, compatibilidade, observações..."></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar Peça</button>
            <a href="/parts" class="btn">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
