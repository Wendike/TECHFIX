<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Nova Transação Financeira</h2>
            <p>Cadastre uma entrada ou saída manual no caixa.</p>
          </div>

          <a href="/finance/transactions" class="btn">Voltar</a>
        </div>

        <form method="POST" action="/finance" class="form-grid">
          <div class="form-group">
            <label>Tipo *</label>
            <select name="type" required>
              <% typeOptions.forEach(function(type) { %>
                <option value="<%= type.value %>"><%= type.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Status *</label>
            <select name="status" required>
              <% statusOptions.forEach(function(status) { %>
                <option value="<%= status.value %>"><%= status.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Categoria *</label>
            <input type="text" name="category" required placeholder="Ex: Venda, Aluguel, Energia, Internet">
          </div>

          <div class="form-group">
            <label>Valor *</label>
            <input type="number" name="amount" step="0.01" min="0" required>
          </div>

          <div class="form-group">
            <label>Data de vencimento</label>
            <input type="date" name="due_date">
          </div>

          <div class="form-group">
            <label>Data de pagamento</label>
            <input type="date" name="paid_at">
          </div>

          <div class="form-group form-full">
            <label>Forma de pagamento</label>
            <input type="text" name="payment_method" placeholder="Pix, Dinheiro, Cartão, Boleto...">
          </div>

          <div class="form-group form-full">
            <label>Descrição *</label>
            <textarea name="description" rows="4" required placeholder="Descreva a movimentação financeira..."></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar Transação</button>
            <a href="/finance/transactions" class="btn">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
