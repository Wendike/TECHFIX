<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Editar Transação Financeira</h2>
            <p>Atualize dados de entrada, saída, vencimento, pagamento e status.</p>
          </div>

          <a href="/finance/transactions" class="btn">Voltar</a>
        </div>

        <form method="POST" action="/finance/<%= transaction.id %>/update" class="form-grid">
          <div class="form-group">
            <label>Tipo *</label>
            <select name="type" required>
              <% typeOptions.forEach(function(type) { %>
                <option value="<%= type.value %>" <%= transaction.type === type.value ? 'selected' : '' %>>
                  <%= type.label %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Status *</label>
            <select name="status" required>
              <% statusOptions.forEach(function(status) { %>
                <option value="<%= status.value %>" <%= transaction.status === status.value ? 'selected' : '' %>>
                  <%= status.label %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Categoria *</label>
            <input type="text" name="category" value="<%= transaction.category %>" required>
          </div>

          <div class="form-group">
            <label>Valor *</label>
            <input type="number" name="amount" step="0.01" min="0" value="<%= transaction.amount || 0 %>" required>
          </div>

          <div class="form-group">
            <label>Data de vencimento</label>
            <input type="date" name="due_date" value="<%= transaction.due_date || '' %>">
          </div>

          <div class="form-group">
            <label>Data de pagamento</label>
            <input type="date" name="paid_at" value="<%= transaction.paid_at ? String(transaction.paid_at).substring(0, 10) : '' %>">
          </div>

          <div class="form-group form-full">
            <label>Forma de pagamento</label>
            <input type="text" name="payment_method" value="<%= transaction.payment_method || '' %>">
          </div>

          <div class="form-group form-full">
            <label>Descrição *</label>
            <textarea name="description" rows="4" required><%= transaction.description || '' %></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Atualizar Transação</button>
            <a href="/finance/transactions" class="btn">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
