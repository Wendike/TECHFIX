<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Saída de Estoque</h2>
            <p>Remova unidades do estoque por venda, reparo, perda ou uso interno.</p>
          </div>

          <a href="/inventory" class="btn">Voltar</a>
        </div>

        <form method="POST" action="/inventory/exit" class="form-grid">
          <div class="form-group">
            <label>Peça *</label>
            <select name="part_id" required>
              <option value="">Selecione uma peça</option>
              <% parts.forEach(function(part) { %>
                <option value="<%= part.id %>" <%= Number(selectedPartId) === Number(part.id) ? 'selected' : '' %>>
                  <%= part.name %> | Estoque atual: <%= part.current_stock %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Quantidade de saída *</label>
            <input type="number" name="quantity" min="1" required>
          </div>

          <div class="form-group">
            <label>Preço unitário aplicado</label>
            <input type="number" name="unit_price" step="0.01" min="0" value="0">
          </div>

          <div class="form-group form-full">
            <label>Motivo / Observação</label>
            <textarea name="reason" rows="4" placeholder="Ex: Venda ao cliente, uso em reparo, descarte, ajuste..."></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-danger">Registrar Saída</button>
            <a href="/inventory" class="btn">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
