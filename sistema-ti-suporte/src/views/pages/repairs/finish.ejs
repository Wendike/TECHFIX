<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Finalizar Reparo</h2>
            <p>Registre a solução final, valores e marque o dispositivo como reparado.</p>
          </div>

          <a href="/repairs/<%= repair.id %>" class="btn">Voltar</a>
        </div>

        <div class="repair-summary">
          <div>
            <span>Cliente</span>
            <strong><%= repair.client_name %></strong>
          </div>

          <div>
            <span>Dispositivo</span>
            <strong><%= repair.device_type %> - <%= repair.brand || '-' %> <%= repair.model || '' %></strong>
          </div>

          <div>
            <span>Status atual</span>
            <strong class="badge <%= statusClasses[repair.status] || 'badge-role' %>">
              <%= statusLabels[repair.status] || repair.status %>
            </strong>
          </div>
        </div>

        <form method="POST" action="/repairs/<%= repair.id %>/finish" class="form-grid">
          <div class="form-group form-full">
            <label>Solução aplicada *</label>
            <textarea name="solution" rows="6" required placeholder="Descreva tudo que foi realizado no reparo..."><%= repair.solution || '' %></textarea>
          </div>

          <div class="form-group">
            <label>Valor da mão de obra</label>
            <input type="number" name="labor_cost" step="0.01" min="0" value="<%= repair.labor_cost || 0 %>">
          </div>

          <div class="form-group">
            <label>Valor das peças</label>
            <input type="number" name="parts_cost" step="0.01" min="0" value="<%= repair.parts_cost || 0 %>">
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-success">Finalizar Reparo</button>
            <a href="/repairs/<%= repair.id %>" class="btn">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
