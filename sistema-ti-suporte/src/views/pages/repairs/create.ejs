<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="app">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/header') %>

      <% if (error && error.length) { %>
        <div class="alert alert-error">
          <% error.forEach(function(message) { %>
            <p><%= message %></p>
          <% }) %>
        </div>
      <% } %>

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>Novo Reparo</h2>
            <p>Abra um reparo para um dispositivo recebido e registre diagnóstico técnico.</p>
          </div>

          <a href="/repairs" class="btn">Voltar</a>
        </div>

        <% if (devices.length === 0) { %>
          <div class="alert alert-error">
            <p>Nenhum dispositivo disponível para reparo. Cadastre uma entrada de dispositivo primeiro.</p>
          </div>
        <% } %>

        <form method="POST" action="/repairs" class="form-grid">
          <div class="form-group form-full">
            <label>Dispositivo *</label>
            <select name="device_id" required>
              <option value="">Selecione um dispositivo</option>
              <% devices.forEach(function(device) { %>
                <option value="<%= device.id %>" <%= Number(selectedDeviceId) === Number(device.id) ? 'selected' : '' %>>
                  #<%= device.id %> - <%= device.client_name %> | <%= device.device_type %> <%= device.brand || '' %> <%= device.model || '' %> | <%= device.problem_description %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Técnico responsável</label>
            <select name="technician_id">
              <option value="">Sem técnico definido</option>
              <% technicians.forEach(function(technician) { %>
                <option value="<%= technician.id %>">
                  <%= technician.name %> - <%= technician.role %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Status</label>
            <select name="status">
              <% statusOptions.forEach(function(option) { %>
                <option value="<%= option.value %>" <%= option.value === 'open' ? 'selected' : '' %>>
                  <%= option.label %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group form-full">
            <label>Diagnóstico técnico *</label>
            <textarea name="diagnosis" rows="5" required placeholder="Descreva o diagnóstico feito pelo técnico..."></textarea>
          </div>

          <div class="form-group form-full">
            <label>Solução proposta / aplicada</label>
            <textarea name="solution" rows="5" placeholder="Descreva a solução, serviço executado ou proposta para aprovação..."></textarea>
          </div>

          <div class="form-group">
            <label>Valor da mão de obra</label>
            <input type="number" name="labor_cost" step="0.01" min="0" value="0">
          </div>

          <div class="form-group">
            <label>Valor das peças</label>
            <input type="number" name="parts_cost" step="0.01" min="0" value="0">
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Abrir Reparo</button>
            <a href="/repairs" class="btn">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
</body>
</html>
